# Database connections
DB_HOST=192.168.1.14
DB_USER=dbuser
DB_PASSWORD=replace-with-your-database-password
DB_RTS_DATABASE=RTS
DB_MAIN_DATABASE=MAINSITE
DB_MUSIC_DATABASE=music_catalog

# Internal services
MUSIC_SERVER=192.168.1.101
RTS_SERVER=192.168.1.113

# API and security
API_PORT=55000
BCRYPT_SALT_ROUNDS=10
SESSION_LENGTH_DAYS=7

# CORS (comma-separated values)
CORS_ORIGINS=http://localhost:55000,http://localhost:8080,http://dowscopemedia.ca
CORS_METHODS=GET,POST
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# File locations
UPLOAD_DIR=./uploads
FILE_LIST_PATH=./fileList.json
MUSIC_RECORD_DIR=/store/Music/Records
MUSIC_LIBRARY_ROOT=/storage/Music

# Website deployment webhook (configure the same secret in your GitHub webhook)
SITE_REPOSITORY_URL=https://github.com/your-account/your-vue-site.git
SITE_REPOSITORY_BRANCH=main
SITE_WEBHOOK_SECRET=replace-with-a-long-random-secret
SITE_WEB_ROOT=/var/www/dowscopemedia.ca/public_html
SITE_BUILD_OUTPUT=dist
